{
    "version": 2,
    "builds": [
        {
            "src": "dist/**",
            "use": "@vercel/static"
        },
        {
            "src": "backend/**/*.js",
            "use": "@vercel/node"
        }
    ],
    "cron": [
        {
            "path": "/backend/index.js",
            "schedule": "* * * * *"
        }
    ]
}